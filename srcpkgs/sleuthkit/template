# Template file for 'sleuthkit'
pkgname=sleuthkit
version=4.15.0
revision=1
build_style=gnu-configure
configure_args="--enable-java"
hostmakedepends="automake libtool openjdk17 apache-ant"
makedepends="libewf-devel sqlite-devel zlib-devel"
depends="perl"
checkdepends="python3 wget"
short_desc="File system and media management forensic analysis tools"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="GPL-2.0-only, IPL-1.0, CPL-1.0"
homepage="https://www.sleuthkit.org/"
changelog="https://github.com/sleuthkit/sleuthkit/releases"
distfiles="https://github.com/sleuthkit/sleuthkit/archive/sleuthkit-${version}.tar.gz"
checksum=4888ef54f9b404853712945218b3168696569db9167d7e01ec76e44b6c05c71c

if [ -e /etc/profile.d/jdk.sh ]; then
	. /etc/profile.d/jdk.sh
fi

if [ -e /etc/profile.d/apache-ant.sh ]; then
	. /etc/profile.d/apache-ant.sh
fi

post_extract() {
	sed -i 's:sys/fcntl.h:fcntl.h:g' tsk/fs/tsk_fs_i.h
}

pre_configure() {
	./bootstrap
}

post_install() {
	vmkdir usr/libexec/autopsy/autopsy/modules
	mv "${DESTDIR}/usr/share/java" "${DESTDIR}/usr/libexec/autopsy/autopsy/modules/ext"
}

autopsy-sleuthkit_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/libexec/autopsy
	}
}

sleuthkit-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
