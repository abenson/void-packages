# Template file for 'autopsy-bin'
pkgname=autopsy-bin
version=4.23.1
revision=1
depends="openjdk17-jre autopsy-sleuthkit"
short_desc="Digital forensics platform"
maintainer="Andrew Benson <abenson+void@gmail.com>"
license="Apache-2.0"
homepage="http://www.sleuthkit.org/autopsy/"
distfiles="https://github.com/sleuthkit/autopsy/releases/download/autopsy-${version}/autopsy-${version}.zip"
checksum=b58cd4c04f42f49823488f05f6a5b43ada470ff7343c2d71dd2e154114d09eae
skip_extraction="autopsy-${version}.zip"
nopie=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	vsrcextract -C "${DESTDIR}/usr/libexec/autopsy" --strip-components=1 "autopsy-${version}.zip"

	# use JNI library from sleuthkit
	rm -f ${DESTDIR}/usr/libexec/autopsy/autopsy/modules/ext/sleuthkit*.jar

	# link executable
	vmkdir usr/bin
	chmod 0755 "${DESTDIR}/usr/libexec/autopsy/bin/autopsy"
	ln -sf "/usr/libexec/autopsy/bin/autopsy" "${DESTDIR}/usr/bin/autopsy"

	# configure JDK home
	vsed -i "${DESTDIR}/usr/libexec/autopsy/etc/autopsy.conf" -e "/^jdkhome=/c\\\njdkhome=/usr/lib/jvm/openjdk17\n"
}
